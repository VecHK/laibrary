{
  "name": "laibrary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @laibrary/server",
    "web": "npm run dev -w @laibrary/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @laibrary/server",
    "db:migrate": "npm run db:migrate -w @laibrary/server",
    "clean": "npm run clean -w @laibrary/server",
    "lint": "oxlint --deny-warnings",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "oxlint": "^1.92.0",
    "typescript": "^5.9.2"
  }
}
