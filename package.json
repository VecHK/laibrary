{
  "name": "laibrary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @laibrary/server",
    "web": "npm run dev -w @laibrary/web",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "db:generate": "npm run db:generate -w @laibrary/server",
    "db:migrate": "npm run db:migrate -w @laibrary/server",
    "clean": "npm run clean -w @laibrary/server",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.49.0"
  }
}
