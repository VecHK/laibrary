{
  "name": "laibrary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "pnpm --filter @laibrary/server dev",
    "web": "pnpm --filter @laibrary/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @laibrary/web build",
    "db:generate": "pnpm --filter @laibrary/server db:generate",
    "db:migrate": "pnpm --filter @laibrary/server db:migrate",
    "clean": "pnpm --filter @laibrary/server clean",
    "lint": "oxlint --deny-warnings",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "^1.92.0",
    "typescript": "^6.0.3"
  }
}
