      "checkConstraints": {
        "items_role_check": {
          "name": "items_role_check",
          "value": "\n    \"items\".\"role\" IN ('page', 'entity', 'text-block', 'text-heading-1', 'text-heading-2', 'text-heading-3', 'image', 'file', 'itemlink', 'tag', 'database')\n  "
        },
        "items_entity_kind_check": {
          "name": "items_entity_kind_check",
          "value": "\n    (\"items\".\"role\" = 'entity') = (\"items\".\"kind\" IS NOT NULL)\n  "
        },
        "items_itemlink_target_check": {
          "name": "items_itemlink_target_check",
          "value": "\n    (\"items\".\"role\" = 'itemlink') = (\"items\".\"target_id\" IS NOT NULL)\n  "
        },
        "items_blob_role_check": {
          "name": "items_blob_role_check",
          "value": "\n    (\"items\".\"role\" IN ('file', 'image')) = (\"items\".\"blob_id\" IS NOT NULL)\n  "
        },
        "items_attributes_object_check": {
          "name": "items_attributes_object_check",
          "value": "\n    jsonb_typeof(\"items\".\"attributes\") = 'object'\n  "
        },
        "items_tags_no_null_check": {
          "name": "items_tags_no_null_check",
          "value": "\n    array_position(\"items\".\"tags\", NULL) IS NULL\n  "
        },
        "items_order_index_finite_check": {
          "name": "items_order_index_finite_check",
          "value": "\n    abs(\"items\".\"order_index\") < 'Infinity'::double precision\n  "
        },
        "items_kind_format_check": {
          "name": "items_kind_format_check",
          "value": "\n    \"items\".\"kind\" IS NULL OR \"items\".\"kind\" ~ '^[a-z][a-z0-9._-]{0,63}$'\n  "
        },
        "items_unity_name_format_check": {
          "name": "items_unity_name_format_check",
          "value": "\n    \"items\".\"unity_name\" IS NULL OR \"items\".\"unity_name\" ~ '^[a-z][a-z0-9._-]{0,199}$'\n  "
        }
      },
